# Team salts from the venue slips. Never commit the real values.
DAY1_SALT=replace-with-your-day1-salt
DAY2_SALT=replace-with-your-day2-salt
# HS256 secret for demo/RBAC JWTs
JWT_SECRET=change-me-local-jwt-secret
# Host name/IP that phones and browsers use to reach the media server (default localhost)
MEDIA_PUBLIC_HOST=localhost
# Optional: laptop LAN IP advertised for WebRTC (phones on the team hotspot)
MEDIA_LAN_IP=
# Set automatically inside docker compose:
# DATABASE_URL=postgres://nascon:nascon@postgres:5432/nascon
# REDIS_URL=redis://redis:6379
# MEDIA_API_URL=http://mediamtx:9997
# MINIO_ENDPOINT=http://minio:9000  MINIO_ROOT_USER=nascon  MINIO_ROOT_PASSWORD=nascon-minio-secret
# PORT=8080
